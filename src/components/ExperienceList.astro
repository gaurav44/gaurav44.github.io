---
import type { Experience } from "@/data/experience";

type Props = {
  items: Experience[];
  compact?: boolean;
};

const { items, compact = false } = Astro.props;

const initials = (company: string) =>
  company
    .split(" ")
    .filter(word => /^[A-Z0-9]/.test(word))
    .slice(0, 2)
    .map(word => word[0])
    .join("");

const techClass = (tag: string) =>
  `tech-${tag
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")}`;
---

<ol class:list={[compact ? "compact-experience-list" : "showcase-timeline"]}>
  {
    items.map(experience => (
      <li class:list={[compact ? "compact-experience-item" : "showcase-item"]}>
        {!compact && (
          <div class="showcase-marker" aria-hidden="true">
            {initials(experience.company)}
          </div>
        )}

        {compact ? (
          <article class="pane pane-pad">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
              <div>
                <p class="text-muted-foreground text-sm font-medium">
                  {experience.period}
                </p>
                <h2 class="text-lg font-semibold">{experience.company}</h2>
                <p class="mt-1 font-medium">{experience.role}</p>
              </div>
              {experience.referenceHref && (
                <a
                  href={experience.referenceHref}
                  target="_blank"
                  class="hover:text-accent border-border rounded border px-2 py-1 text-sm no-underline"
                >
                  Reference
                </a>
              )}
            </div>
            <p class="text-muted-foreground mt-3">{experience.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {experience.tags.map(tag => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>
          </article>
        ) : (
          <article class="showcase-card">
            <header class="showcase-header">
              <div>
                <p class="showcase-period">{experience.period}</p>
                <h2>{experience.company}</h2>
                <p class="showcase-role">
                  {experience.role}
                  {experience.product && `, ${experience.product}`}
                </p>
              </div>

              {experience.referenceHref && (
                <a
                  href={experience.referenceHref}
                  target="_blank"
                  class="reference-link"
                >
                  Reference ↗
                </a>
              )}
            </header>

            <div class="showcase-grid">
              <figure class="diagram-panel">
                <p>{experience.visual?.label}</p>

                {experience.visual?.kind === "dem-pipeline" ? (
                  <svg
                    viewBox="0 40 520 470"
                    role="img"
                    aria-label={experience.visual.caption}
                  >
                    <defs>
                      <radialGradient
                        id="particleGlow"
                        cx="50%"
                        cy="50%"
                        r="50%"
                      >
                        <stop offset="0%" stop-color="#a7b8ff" />
                        <stop offset="100%" stop-color="#5e74d8" />
                      </radialGradient>
                    </defs>

                    <text x="34" y="68" class="diagram-label">
                      Particles
                    </text>
                    <g fill="url(#particleGlow)">
                      <circle cx="150" cy="88" r="3" />
                      <circle cx="185" cy="80" r="3" />
                      <circle cx="218" cy="96" r="4" />
                      <circle cx="255" cy="84" r="3" />
                      <circle cx="290" cy="102" r="4" />
                      <circle cx="324" cy="90" r="3" />
                      <circle cx="138" cy="126" r="4" />
                      <circle cx="166" cy="118" r="3" />
                      <circle cx="198" cy="134" r="5" />
                      <circle cx="232" cy="122" r="3" />
                      <circle cx="264" cy="136" r="4" />
                      <circle cx="300" cy="128" r="3" />
                      <circle cx="330" cy="142" r="4" />
                      <circle cx="152" cy="164" r="3" />
                      <circle cx="186" cy="154" r="4" />
                      <circle cx="222" cy="168" r="3" />
                      <circle cx="258" cy="160" r="5" />
                      <circle cx="296" cy="174" r="4" />
                    </g>

                    <path
                      d="M92 224 H374 L420 282 H46 Z M70 244 H394 M58 262 H408 M112 224 L82 282 M154 224 L136 282 M196 224 L190 282 M238 224 L244 282 M280 224 L298 282 M322 224 L352 282"
                      class="mesh"
                    />

                    <path d="M344 140 H414" class="dashed-line" />
                    <text x="424" y="132" class="diagram-label">
                      Particle-Mesh
                    </text>
                    <text x="424" y="152" class="diagram-label">
                      Mapping
                    </text>

                    <path
                      d="M238 282 V318 M112 318 H374 M112 318 V344 M238 318 V344 M374 318 V344"
                      class="connector"
                    />

                    <g>
                      <rect
                        x="80"
                        y="344"
                        width="76"
                        height="62"
                        rx="6"
                        class="backend cuda"
                      />
                      <text
                        x="118"
                        y="369"
                        text-anchor="middle"
                        class="backend-title cuda-text"
                      >
                        CUDA
                      </text>
                      <path
                        d="M96 382 H140 M96 392 H140 M102 376 V400 M114 376 V400 M126 376 V400 M138 376 V400"
                        class="backend-grid cuda-text"
                      />

                      <rect
                        x="202"
                        y="344"
                        width="76"
                        height="62"
                        rx="6"
                        class="backend hip"
                      />
                      <text
                        x="240"
                        y="369"
                        text-anchor="middle"
                        class="backend-title hip-text"
                      >
                        HIP
                      </text>
                      <path
                        d="M218 392 H262 M218 382 H262 M224 376 V400 M236 376 V400 M248 376 V400 M260 376 V400"
                        class="backend-grid hip-text"
                      />

                      <text x="314" y="380" text-anchor="middle" class="dots">
                        ...
                      </text>

                      <rect
                        x="360"
                        y="344"
                        width="82"
                        height="62"
                        rx="6"
                        class="backend openmp"
                      />
                      <text
                        x="401"
                        y="369"
                        text-anchor="middle"
                        class="backend-title openmp-text"
                      >
                        OpenMP
                      </text>
                      <path
                        d="M376 382 H424 M376 392 H424 M382 376 V400 M394 376 V400 M406 376 V400 M418 376 V400"
                        class="backend-grid openmp-text"
                      />
                    </g>

                    <path
                      d="M118 406 V432 M240 406 V432 M401 406 V432 M118 432 H401"
                      class="connector"
                    />

                    <g class="server-row">
                      <rect x="70" y="444" width="54" height="40" rx="4" />
                      <rect x="150" y="444" width="54" height="40" rx="4" />
                      <rect x="230" y="444" width="54" height="40" rx="4" />
                      <rect x="310" y="444" width="54" height="40" rx="4" />
                      <circle cx="82" cy="456" r="3" />
                      <circle cx="162" cy="456" r="3" />
                      <circle cx="242" cy="456" r="3" />
                      <circle cx="322" cy="456" r="3" />
                      <path d="M94 456 H114 M174 456 H194 M254 456 H274 M334 456 H354 M82 470 H114 M162 470 H194 M242 470 H274 M322 470 H354" />
                    </g>
                    <text x="420" y="454" class="diagram-label">
                      MPI
                    </text>
                    <text x="420" y="474" class="diagram-label">
                      Nodes
                    </text>
                    <text
                      x="238"
                      y="504"
                      text-anchor="middle"
                      class="diagram-caption"
                    >
                      Distributed Simulation
                    </text>
                  </svg>
                ) : (
                  <svg
                    viewBox="0 0 420 500"
                    role="img"
                    aria-label={experience.visual?.caption}
                  >
                    <defs>
                      <marker
                        id="arrowHead"
                        markerWidth="8"
                        markerHeight="8"
                        refX="6"
                        refY="4"
                        orient="auto"
                      >
                        <path d="M0 0 L8 4 L0 8 Z" class="arrow-head" />
                      </marker>
                    </defs>

                    <rect
                      x="120"
                      y="22"
                      width="180"
                      height="70"
                      rx="10"
                      class="cosim-node"
                    />
                    <text
                      x="210"
                      y="66"
                      text-anchor="middle"
                      class="cosim-node-text"
                    >
                      nFX
                    </text>

                    <rect
                      x="38"
                      y="174"
                      width="160"
                      height="86"
                      rx="10"
                      class="cosim-library transfer-force"
                    />
                    <text
                      x="118"
                      y="204"
                      text-anchor="middle"
                      class="cosim-text"
                    >
                      fluid forces
                    </text>
                    <text
                      x="118"
                      y="228"
                      text-anchor="middle"
                      class="cosim-text"
                    >
                      + torques on
                    </text>
                    <text
                      x="118"
                      y="250"
                      text-anchor="middle"
                      class="cosim-text secondary"
                    >
                      rigid bodies
                    </text>

                    <rect
                      x="222"
                      y="174"
                      width="160"
                      height="96"
                      rx="10"
                      class="cosim-library transfer-motion"
                    />
                    <text
                      x="302"
                      y="204"
                      text-anchor="middle"
                      class="cosim-text"
                    >
                      translation
                    </text>
                    <text
                      x="302"
                      y="228"
                      text-anchor="middle"
                      class="cosim-text"
                    >
                      vector +
                    </text>
                    <text
                      x="302"
                      y="252"
                      text-anchor="middle"
                      class="cosim-text secondary"
                    >
                      quaternions
                    </text>

                    <rect
                      x="104"
                      y="402"
                      width="212"
                      height="74"
                      rx="10"
                      class="cosim-node"
                    />
                    <text
                      x="210"
                      y="448"
                      text-anchor="middle"
                      class="cosim-node-text"
                    >
                      MotionSolve
                    </text>

                    <path
                      d="M118 94 V168"
                      class="cosim-arrow force-arrow"
                      marker-end="url(#arrowHead)"
                    />
                    <path
                      d="M118 262 V396"
                      class="cosim-arrow force-arrow"
                      marker-end="url(#arrowHead)"
                    />
                    <path
                      d="M302 396 V276"
                      class="cosim-arrow motion-arrow"
                      marker-end="url(#arrowHead)"
                    />
                    <path
                      d="M302 168 V94"
                      class="cosim-arrow motion-arrow"
                      marker-end="url(#arrowHead)"
                    />
                  </svg>
                )}
              </figure>

              <div class="detail-panel">
                {experience.context && (
                  <p class="context-box">{experience.context}</p>
                )}

                {experience.impacts && (
                  <section class="impact-section">
                    <div class="section-rule">
                      <h3>Key Impact</h3>
                      <span />
                    </div>
                    <ul>
                      {experience.impacts.map(impact => (
                        <li>
                          <div
                            class:list={[
                              "impact-icon",
                              impact.icon && `impact-${impact.icon}`,
                            ]}
                            aria-hidden="true"
                          >
                            {impact.icon === "speed" ? (
                              <svg viewBox="0 0 24 24">
                                <path d="M4 14a8 8 0 1 1 16 0" />
                                <path d="M12 14 17 8" />
                                <path d="M7 14h1M16 14h1M6.7 9.8l.8.5M16.5 10.3l.8-.5" />
                              </svg>
                            ) : impact.icon === "backend" ? (
                              <svg viewBox="0 0 24 24">
                                <rect x="7" y="7" width="10" height="10" />
                                <path d="M3 9h4M3 15h4M17 9h4M17 15h4M9 3v4M15 3v4M9 17v4M15 17v4" />
                              </svg>
                            ) : impact.icon === "distributed" ? (
                              <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="5" r="3" />
                                <circle cx="5" cy="18" r="3" />
                                <circle cx="19" cy="18" r="3" />
                                <path d="M10.5 7.5 6.5 15.5M13.5 7.5 17.5 15.5M8 18h8" />
                              </svg>
                            ) : impact.icon === "diagnostics" ? (
                              <svg viewBox="0 0 24 24">
                                <path d="M14.5 5.5a4 4 0 0 0-5 5L4 16l4 4 5.5-5.5a4 4 0 0 0 5-5l-3 3-4-4z" />
                                <path d="M15 19h6M18 16v6" />
                              </svg>
                            ) : impact.icon === "cmake" ? (
                              <svg
                                viewBox="0 0 24 24"
                                class="impact-cmake-logo"
                              >
                                <path
                                  d="M12 3 4 20h16z"
                                  fill="#4f86d9"
                                  stroke="none"
                                />
                                <path
                                  d="M12 3v17H4z"
                                  fill="#48a868"
                                  stroke="none"
                                />
                                <path
                                  d="M12 3 20 20h-8z"
                                  fill="#c95047"
                                  stroke="none"
                                />
                              </svg>
                            ) : impact.icon === "coupling" ? (
                              <svg viewBox="0 0 24 24">
                                <path d="M9 7h-1a5 5 0 0 0 0 10h3M15 7h1a5 5 0 0 1 0 10h-3M8 12h8" />
                              </svg>
                            ) : (
                              "▣"
                            )}
                          </div>
                          <p class="impact-value">{impact.value}</p>
                          <p class="impact-label">{impact.label}</p>
                          <p class="impact-description">{impact.description}</p>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            </div>

            <section class="contribution-section">
              <div class="section-rule">
                <h3>Core Contributions</h3>
                <span />
              </div>
              <ul>
                {experience.highlights.map(highlight => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </section>

            <div class="tech-row">
              {experience.tags.map(tag => (
                <span class={techClass(tag)}>
                  <b aria-hidden="true">
                    {tag === "C++" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2 21 7v10l-9 5-9-5V7z" />
                        <path d="M14.6 8.8a4 4 0 1 0 0 6.4M16.5 10v4M18.5 10v4M15.4 12h4.2" />
                      </svg>
                    ) : tag === "CUDA" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M2.5 12c3.2-5.2 7.2-7.8 12-7.8 2.9 0 5.2.9 7 2.8-2.6-.8-5.2-.5-7.8.8C9.9 9.8 7 12.6 5 16.2c1.8-1.1 3.8-1.6 6-1.5 2.8.1 5.4 1.3 7.8 3.5-2.1 1.1-4.4 1.5-6.8 1.1-3.7-.6-6.8-3-9.5-7.3Z" />
                        <path d="M8.5 12.3c2-2.2 4.2-3.3 6.5-3.1 1.4.1 2.7.6 3.9 1.5-1.8-.3-3.5-.1-5 .8-1.7.9-3 2.1-3.9 3.6" />
                      </svg>
                    ) : tag === "HIP" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M4 15h6V9h6l4-4v14H6z" />
                        <path d="M10 15 20 5M10 9v10" />
                      </svg>
                    ) : tag === "OpenMP" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M4 6h14a3 3 0 0 1 0 6H8M4 18h14a3 3 0 0 0 0-6H8" />
                      </svg>
                    ) : tag === "MPI" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2 21 7v10l-9 5-9-5V7z" />
                        <path d="M12 2v10m9-5-9 5-9-5m4.5 7.5 4.5 2.5 4.5-2.5" />
                      </svg>
                    ) : tag === "Kokkos" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 3 20 8v8l-8 5-8-5V8z" />
                        <path d="M8 9.5 12 7l4 2.5v5L12 17l-4-2.5z" />
                        <path d="M4 8 12 12l8-4M12 12v9" />
                      </svg>
                    ) : tag === "CMake" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 3 4 20h16z" fill="#4f86d9" stroke="none" />
                        <path d="M12 3v17H4z" fill="#48a868" stroke="none" />
                        <path
                          d="M12 3 20 20h-8z"
                          fill="#c95047"
                          stroke="none"
                        />
                      </svg>
                    ) : tag === "Python" ? (
                      <svg viewBox="0 0 24 24">
                        <path
                          d="M6 11V6c0-2 1.2-3 3.2-3H15v4H9v2h9c2 0 3 1.2 3 3.2V14h-7v-3z"
                          fill="#3776ab"
                          stroke="none"
                        />
                        <path
                          d="M18 13v5c0 2-1.2 3-3.2 3H9v-4h6v-2H6c-2 0-3-1.2-3-3.2V10h7v3z"
                          fill="#ffd343"
                          stroke="none"
                        />
                      </svg>
                    ) : tag === "Multi-GPU" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M4 5h7v6H4zM13 5h7v6h-7zM4 13h7v6H4zM13 13h7v6h-7z" />
                        <path d="M7.5 11v2M16.5 11v2M11 8h2M11 16h2" />
                      </svg>
                    ) : (
                      tag.slice(0, 2)
                    )}
                  </b>
                  {tag}
                </span>
              ))}
            </div>
          </article>
        )}
      </li>
    ))
  }
</ol>

<style>
  :global(.experience-section-title) {
    color: #d8b273;
    font-size: clamp(1.55rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .showcase-timeline {
    position: relative;
    display: grid;
    gap: 1.35rem;
    margin-top: 1.5rem;
    padding-left: 4.25rem;
  }

  .showcase-timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1.75rem;
    width: 2px;
    background: linear-gradient(#d8b273, #d8b273);
    opacity: 0.9;
  }

  .showcase-item {
    position: relative;
  }

  .showcase-marker {
    position: absolute;
    top: 1.2rem;
    left: -4.25rem;
    z-index: 1;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 999px;
    background: #d8b273;
    color: #151818;
    font-size: 1rem;
    font-weight: 800;
    box-shadow: 0 0 0 4px #101414;
  }

  .showcase-card {
    border: 1px solid rgba(216, 178, 115, 0.36);
    border-radius: 8px;
    background:
      radial-gradient(
        circle at 18% 0%,
        rgba(216, 178, 115, 0.08),
        transparent 22rem
      ),
      linear-gradient(145deg, rgba(17, 21, 21, 0.98), rgba(10, 13, 13, 0.98));
    color: #ead8bb;
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.22);
    padding: clamp(1.35rem, 2.8vw, 2rem);
  }

  .showcase-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .showcase-period {
    color: rgba(234, 216, 187, 0.74);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .showcase-header h2 {
    margin-top: 0.3rem;
    color: #d8b273;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .showcase-role {
    margin-top: 0.45rem;
    color: #ead8bb;
    font-size: 1.12rem;
    font-weight: 600;
  }

  .reference-link {
    flex: none;
    border: 1px solid rgba(216, 178, 115, 0.38);
    border-radius: 5px;
    color: #d8b273;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.55rem 0.8rem;
    text-decoration: none;
  }

  .reference-link:hover {
    border-color: #d8b273;
    color: #f0cc8a;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(22rem, 0.85fr) minmax(34rem, 1.15fr);
    gap: 1.55rem;
    align-items: start;
    margin-top: 1.45rem;
  }

  .diagram-panel {
    border: 1px solid rgba(216, 178, 115, 0.2);
    border-radius: 5px;
    background: rgba(9, 12, 12, 0.46);
    max-height: 28rem;
    overflow: hidden;
    padding: 1rem;
    align-self: start;
  }

  .diagram-panel > p {
    color: rgba(234, 216, 187, 0.76);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .diagram-panel svg {
    display: block;
    width: 100%;
    max-height: 25rem;
    height: auto;
    margin-top: 0.7rem;
    object-fit: contain;
  }

  .diagram-label,
  .diagram-caption {
    fill: #ead8bb;
    font-weight: 500;
  }

  .mesh {
    fill: none;
    stroke: #7d93d9;
  }

  .dashed-line {
    fill: none;
    stroke: rgba(234, 216, 187, 0.58);
    stroke-dasharray: 6 5;
  }

  .connector {
    fill: none;
    stroke: rgba(234, 216, 187, 0.34);
  }

  .backend {
    stroke-width: 1.5;
  }

  .cuda {
    fill: rgba(160, 209, 98, 0.12);
    stroke: #a0d162;
  }

  .cuda-text {
    fill: #a0d162;
    stroke: #a0d162;
  }

  .hip {
    fill: rgba(207, 139, 239, 0.12);
    stroke: #cf8bef;
  }

  .hip-text {
    fill: #cf8bef;
    stroke: #cf8bef;
  }

  .openmp {
    fill: rgba(90, 205, 194, 0.12);
    stroke: #5acdc2;
  }

  .openmp-text {
    fill: #5acdc2;
    stroke: #5acdc2;
  }

  .backend-title,
  .stack text {
    font-weight: 700;
  }

  .backend-grid {
    fill: none;
    stroke-width: 1;
  }

  .dots {
    fill: rgba(234, 216, 187, 0.7);
  }

  .server-row rect {
    fill: rgba(234, 216, 187, 0.08);
    stroke: rgba(234, 216, 187, 0.22);
  }

  .server-row circle {
    fill: #6cc6d5;
    stroke: none;
  }

  .server-row path {
    fill: none;
    stroke: rgba(216, 178, 115, 0.45);
    stroke-width: 1;
  }

  .streamline {
    fill: none;
    stroke: url(#flowGradient);
    stroke-width: 2;
    opacity: 0.8;
  }

  .body {
    fill: rgba(234, 216, 187, 0.2);
    stroke: rgba(234, 216, 187, 0.36);
  }

  .cosim-node {
    fill: rgba(234, 216, 187, 0.035);
    stroke: rgba(216, 178, 115, 0.62);
    stroke-width: 1.8;
  }

  .cosim-library {
    fill: rgba(216, 178, 115, 0.1);
    stroke: rgba(216, 178, 115, 0.74);
    stroke-width: 1.8;
  }

  .transfer-force {
    fill: rgba(160, 209, 98, 0.08);
    stroke: rgba(160, 209, 98, 0.75);
  }

