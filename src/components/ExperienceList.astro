---
import SkillChip from "@/components/SkillChip.astro";
import type { Experience } from "@/data/experience";

type Props = {
  items: Experience[];
  compact?: boolean;
};

const { items, compact = false } = Astro.props;

const initials = (company: string) =>
  company
    .split(" ")
    .filter(word => /^[A-Z0-9]/.test(word))
    .slice(0, 2)
    .map(word => word[0])
    .join("");

const techClass = (tag: string) =>
  `tech-${tag
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")}`;
---

<ol class:list={[compact ? "compact-experience-list" : "showcase-timeline"]}>
  {
    items.map(experience => (
      <li class:list={[compact ? "compact-experience-item" : "showcase-item"]}>
        {!compact && (
          <div class="showcase-marker" aria-hidden="true">
            {initials(experience.company)}
          </div>
        )}

        {compact ? (
          <article class="pane pane-pad">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
              <div>
                <p class="text-muted-foreground text-sm font-medium">
                  {experience.period}
                </p>
                <h2 class="text-lg font-semibold">{experience.company}</h2>
                <p class="mt-1 font-medium">{experience.role}</p>
              </div>
              {experience.referenceHref && (
                <a
                  href={experience.referenceHref}
                  target="_blank"
                  class="hover:text-accent border-border rounded border px-2 py-1 text-sm no-underline"
                >
                  Reference
                </a>
              )}
            </div>
            <p class="text-muted-foreground mt-3">{experience.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {experience.tags.map(tag => (
                <SkillChip label={tag} />
              ))}
            </div>
          </article>
        ) : (
          <article class="showcase-card">
            <header class="showcase-header">
              <div>
                <p class="showcase-period">{experience.period}</p>
                <h2>{experience.company}</h2>
                <p class="showcase-role">
                  {experience.role}
                  {experience.product && `, ${experience.product}`}
                </p>
              </div>

              {experience.referenceHref && (
                <a
                  href={experience.referenceHref}
                  target="_blank"
                  class="reference-link"
                >
                  Reference ↗
                </a>
              )}
            </header>

            {experience.context && (
              <p class="context-box">{experience.context}</p>
            )}

            {experience.impacts && (
              <section class="impact-section">
                <div class="section-rule">
                  <h3>Key Impact</h3>
                  <span />
                </div>
                <ul>
                  {experience.impacts.map(impact => (
                    <li>
                      <div
                        class:list={[
                          "impact-icon",
                          impact.icon && `impact-${impact.icon}`,
                        ]}
                        aria-hidden="true"
                      >
                        {impact.icon === "speed" ? (
                          <svg viewBox="0 0 24 24">
                            <path d="M4 14a8 8 0 1 1 16 0" />
                            <path d="M12 14 17 8" />
                            <path d="M7 14h1M16 14h1M6.7 9.8l.8.5M16.5 10.3l.8-.5" />
                          </svg>
                        ) : impact.icon === "backend" ? (
                          <svg viewBox="0 0 24 24">
                            <rect x="7" y="7" width="10" height="10" />
                            <path d="M3 9h4M3 15h4M17 9h4M17 15h4M9 3v4M15 3v4M9 17v4M15 17v4" />
                          </svg>
                        ) : impact.icon === "distributed" ? (
                          <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="5" r="3" />
                            <circle cx="5" cy="18" r="3" />
                            <circle cx="19" cy="18" r="3" />
                            <path d="M10.5 7.5 6.5 15.5M13.5 7.5 17.5 15.5M8 18h8" />
                          </svg>
                        ) : impact.icon === "diagnostics" ? (
                          <svg viewBox="0 0 24 24">
                            <path d="M14.5 5.5a4 4 0 0 0-5 5L4 16l4 4 5.5-5.5a4 4 0 0 0 5-5l-3 3-4-4z" />
                            <path d="M15 19h6M18 16v6" />
                          </svg>
                        ) : impact.icon === "cmake" ? (
                          <svg viewBox="0 0 24 24" class="filled-logo">
                            <path
                              d="M12 3 4 20h16z"
                              fill="#4f86d9"
                              stroke="none"
                            />
                            <path
                              d="M12 3v17H4z"
                              fill="#48a868"
                              stroke="none"
                            />
                            <path
                              d="M12 3 20 20h-8z"
                              fill="#c95047"
                              stroke="none"
                            />
                          </svg>
                        ) : impact.icon === "coupling" ? (
                          <svg viewBox="0 0 24 24">
                            <path d="M9 7h-1a5 5 0 0 0 0 10h3M15 7h1a5 5 0 0 1 0 10h-3M8 12h8" />
                          </svg>
                        ) : (
                          "▣"
                        )}
                      </div>
                      <p class="impact-value">{impact.value}</p>
                      <p class="impact-label">{impact.label}</p>
                      <p class="impact-description">{impact.description}</p>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <section class="contribution-section">
              <div class="section-rule">
                <h3>Core Contributions</h3>
                <span />
              </div>
              <ul>
                {experience.highlights.map(highlight => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </section>

            <div class="tech-row">
              {experience.tags.map(tag => (
                <span class={techClass(tag)}>
                  <b aria-hidden="true">
                    {tag === "C++" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2 21 7v10l-9 5-9-5V7z" />
                        <path d="M14.6 8.8a4 4 0 1 0 0 6.4M16.5 10v4M18.5 10v4M15.4 12h4.2" />
                      </svg>
                    ) : tag === "CUDA" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M2.5 12c3.2-5.2 7.2-7.8 12-7.8 2.9 0 5.2.9 7 2.8-2.6-.8-5.2-.5-7.8.8C9.9 9.8 7 12.6 5 16.2c1.8-1.1 3.8-1.6 6-1.5 2.8.1 5.4 1.3 7.8 3.5-2.1 1.1-4.4 1.5-6.8 1.1-3.7-.6-6.8-3-9.5-7.3Z" />
                        <path d="M8.5 12.3c2-2.2 4.2-3.3 6.5-3.1 1.4.1 2.7.6 3.9 1.5-1.8-.3-3.5-.1-5 .8-1.7.9-3 2.1-3.9 3.6" />
                      </svg>
                    ) : tag === "HIP" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M4 15h6V9h6l4-4v14H6z" />
                        <path d="M10 15 20 5M10 9v10" />
                      </svg>
                    ) : tag === "OpenMP" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M4 6h14a3 3 0 0 1 0 6H8M4 18h14a3 3 0 0 0 0-6H8" />
                      </svg>
                    ) : tag === "MPI" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2 21 7v10l-9 5-9-5V7z" />
                        <path d="M12 2v10m9-5-9 5-9-5m4.5 7.5 4.5 2.5 4.5-2.5" />
                      </svg>
                    ) : tag === "Kokkos" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 3 20 8v8l-8 5-8-5V8z" />
                        <path d="M8 9.5 12 7l4 2.5v5L12 17l-4-2.5z" />
                        <path d="M4 8 12 12l8-4M12 12v9" />
                      </svg>
                    ) : tag === "CMake" ? (
                      <svg viewBox="0 0 24 24" class="filled-logo">
                        <path d="M12 3 4 20h16z" fill="#4f86d9" stroke="none" />
                        <path d="M12 3v17H4z" fill="#48a868" stroke="none" />
                        <path
                          d="M12 3 20 20h-8z"
                          fill="#c95047"
                          stroke="none"
                        />
                      </svg>
                    ) : tag === "Python" ? (
                      <svg viewBox="0 0 24 24" class="filled-logo">
                        <path
                          d="M6 11V6c0-2 1.2-3 3.2-3H15v4H9v2h9c2 0 3 1.2 3 3.2V14h-7v-3z"
                          fill="#3776ab"
                          stroke="none"
                        />
                        <path
                          d="M18 13v5c0 2-1.2 3-3.2 3H9v-4h6v-2H6c-2 0-3-1.2-3-3.2V10h7v3z"
                          fill="#ffd343"
                          stroke="none"
                        />
                      </svg>
                    ) : tag === "Multi-GPU" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M4 5h7v6H4zM13 5h7v6h-7zM4 13h7v6H4zM13 13h7v6h-7z" />
                        <path d="M7.5 11v2M16.5 11v2M11 8h2M11 16h2" />
                      </svg>
                    ) : (
                      tag.slice(0, 2)
                    )}
                  </b>
                  {tag}
                </span>
              ))}
            </div>
          </article>
        )}
      </li>
    ))
  }
</ol>

<style>
  :global(.experience-section-title) {
    color: #d8b273;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .showcase-timeline {
    position: relative;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-left: 3.5rem;
  }

  .showcase-timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1.45rem;
    width: 2px;
    background: #d8b273;
    opacity: 0.75;
  }

  .showcase-item {
    position: relative;
  }

  .showcase-marker {
    position: absolute;
    top: 1rem;
    left: -3.5rem;
    z-index: 1;
    display: grid;
    width: 2.55rem;
    height: 2.55rem;
    place-items: center;
    border-radius: 999px;
    background: #d8b273;
    color: #151818;
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: 0 0 0 4px #101414;
  }

  .showcase-card {
    border: 1px solid rgba(216, 178, 115, 0.36);
    border-radius: 8px;
    background:
      radial-gradient(
        circle at 18% 0%,
        rgba(216, 178, 115, 0.08),
        transparent 18rem
      ),
      linear-gradient(145deg, rgba(17, 21, 21, 0.98), rgba(10, 13, 13, 0.98));
    color: #ead8bb;
    box-shadow: 0 16px 46px rgba(0, 0, 0, 0.18);
    padding: 1.15rem;
  }

  .showcase-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .showcase-period {
    color: rgba(234, 216, 187, 0.74);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .showcase-header h2 {
    margin-top: 0.25rem;
    color: #d8b273;
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .showcase-role {
    margin-top: 0.4rem;
    color: #ead8bb;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .reference-link {
    flex: none;
    border: 1px solid rgba(216, 178, 115, 0.38);
    border-radius: 5px;
    color: #d8b273;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 0.65rem;
    text-decoration: none;
  }

  .reference-link:hover {
    border-color: #d8b273;
    color: #f0cc8a;
  }

  .context-box {
    border: 1px solid rgba(216, 178, 115, 0.24);
    border-radius: 5px;
    background: rgba(216, 178, 115, 0.04);
    color: #ead8bb;
    font-size: 0.95rem;
    line-height: 1.65;
    margin-top: 1rem;
    padding: 0.7rem 0.85rem;
  }

  .section-rule {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-top: 1.2rem;
  }

  .section-rule h3 {
    flex: none;
    color: #d8b273;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-rule span {
    height: 1px;
    flex: 1;
    background: rgba(216, 178, 115, 0.26);
  }

  .impact-section ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 0.9rem;
  }

  .impact-section li {
    border-right: 1px solid rgba(216, 178, 115, 0.24);
    min-width: 0;
    padding: 0 0.8rem;
    text-align: center;
  }

  .impact-section li:first-child {
    padding-left: 0;
  }

  .impact-section li:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .impact-icon {
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    margin: 0 auto 0.25rem;
    place-items: center;
    color: #91c967;
  }

  .impact-icon svg {
    width: 2rem;
    height: 2rem;
    overflow: visible;
  }

  .impact-icon svg path,
  .impact-icon svg rect,
  .impact-icon svg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .impact-backend,
  .impact-diagnostics {
    color: #d7a6f2;
  }

  .impact-distributed,
  .impact-coupling {
    color: #82aaff;
  }

  .filled-logo path {
    stroke: none;
  }

  .impact-value {
    color: #a0d162;
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .impact-label {
    margin-top: 0.25rem;
    color: #d7a6f2;
    font-size: 0.9rem;
    font-weight: 800;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .impact-description {
    margin-top: 0.35rem;
    color: #ead8bb;
    font-size: 0.85rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .contribution-section ul {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    color: #ead8bb;
    font-size: 0.92rem;
    line-height: 1.5;
    list-style: disc;
  }

  .contribution-section li + li {
    margin-top: 0.3rem;
  }

  .tech-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 0.45rem;
    margin-top: 1rem;
    width: 100%;
  }

  .tech-row span {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(216, 178, 115, 0.28);
    border-radius: 5px;
    background: rgba(234, 216, 187, 0.04);
    color: #ead8bb;
    font-size: 0.85rem;
    font-weight: 700;
    min-height: 2.45rem;
    padding: 0.4rem 0.6rem;
  }

  .tech-row b {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    color: #82aaff;
    line-height: 1;
  }

  .tech-row svg {
    width: 1.3rem;
    height: 1.3rem;
    overflow: visible;
  }

  .tech-row svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tech-cuda b {
    color: #8bc34a;
  }

  .tech-hip b {
    color: #df6b57;
  }

  .tech-openmp b {
    color: #5acdc2;
  }

  .tech-mpi b,
  .tech-multi-gpu b {
    color: #6da8ff;
  }

  .tech-kokkos b {
    color: #b89be8;
  }

  .tech-cmake b {
    color: #5dbb63;
  }

  .tech-python b {
    color: #f2c14e;
  }

  .compact-experience-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 700px) {
    .showcase-timeline {
      padding-left: 2.8rem;
    }

    .showcase-marker {
      left: -3.1rem;
      width: 2.25rem;
      height: 2.25rem;
      font-size: 0.78rem;
    }

    .showcase-header,
    .impact-section ul {
      display: block;
    }

    .reference-link {
      display: inline-block;
      margin-top: 0.75rem;
    }

    .impact-section li {
      border-right: 0;
      border-bottom: 1px solid rgba(216, 178, 115, 0.24);
      padding: 0 0 0.9rem;
      margin-top: 0.9rem;
    }

    .impact-section li:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
  }
</style>
