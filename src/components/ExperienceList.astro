---
type Experience = {
  company: string;
  role: string;
  period: string;
  highlights: string[];
  tags: string[];
  referenceHref?: string;
};

type Props = {
  items: Experience[];
};

const { items } = Astro.props;
---

<ol class="mt-6">
  {
    items.map(experience => (
      <li class="border-border mb-8 border-s ps-4">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-xl font-semibold">
            {experience.company}
          </h2>

          {experience.period && (
            <p class="text-sm opacity-75">
              {experience.period}
            </p>
          )}
        </div>

        {experience.role && (
          <p class="mt-1 font-medium">
            {experience.role}
          </p>
        )}

        {
          experience.referenceHref && (
            <p class="mt-2">
              <a
                href={experience.referenceHref}
                target="_blank"
                class="hover:text-accent underline decoration-dashed underline-offset-4"
              >
                View reference letter
              </a>
            </p>
          )
        }

        <ul class="mt-3 list-disc space-y-1 ps-5">
          {experience.highlights.map(highlight => (
            <li>
              {highlight}
            </li>
          ))}
        </ul>

        <div class="mt-3 flex flex-wrap gap-2">
          {experience.tags.map(tag => (
            <span class="border-border bg-card text-foreground rounded-full border px-2 py-0.5 text-xs font-medium">
              #{tag}
            </span>
          ))}
        </div>
      </li>
    ))
  }
</ol>
