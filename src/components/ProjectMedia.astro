---
import type { ProjectMediaItem } from "@/data/projects";

interface Props {
  media?: ProjectMediaItem | ProjectMediaItem[];
}

const { media } = Astro.props;
const items = media ? (Array.isArray(media) ? media : [media]) : [];
const hasCarousel = items.length > 1;
---

{
  items.length > 0 && (
    <figure
      class:list={[
        "project-media bg-surface/50 overflow-hidden rounded border",
        hasCarousel && "project-media-carousel",
      ]}
      style={`--project-media-count: ${items.length}`}
    >
      <div class="project-media-stage">
        {items.map((item, index) => (
          <div
            class:list={[
              "project-media-frame",
              hasCarousel && "project-media-frame-animated",
            ]}
            style={`--project-media-index: ${index}`}
          >
            <img src={item.src} alt={item.alt} loading="lazy" />
            {item.caption && (
              <p class="project-media-caption">{item.caption}</p>
            )}
          </div>
        ))}
      </div>
    </figure>
  )
}

<style>
  .project-media {
    --project-media-count: 1;
  }

  .project-media-stage {
    display: grid;
    aspect-ratio: 13 / 9;
    width: 100%;
    background: color-mix(in srgb, var(--muted) 18%, transparent);
  }

  .project-media-frame {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-width: 0;
    opacity: 1;
  }

  .project-media-frame img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .project-media-caption {
    min-height: 2.25rem;
    border-top: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .project-media-frame-animated {
    opacity: 0;
    animation: project-media-fade calc(var(--project-media-count) * 4s) infinite;
    animation-delay: calc(var(--project-media-index) * 4s);
  }

  @keyframes project-media-fade {
    0%,
    45% {
      opacity: 1;
    }

    55%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media-frame-animated {
      animation: none;
      opacity: 0;
    }

    .project-media-frame-animated:first-child {
      opacity: 1;
    }
  }
</style>
