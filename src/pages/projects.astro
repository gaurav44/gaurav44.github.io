---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectMedia from "@/components/ProjectMedia.astro";
import SkillChip from "@/components/SkillChip.astro";
import { projects } from "@/data/projects";
import config from "@/config";
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="A broader list of software, HPC, CFD, and engineering projects."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Projects"
    pageDesc="A broader list of software, HPC, CFD, and engineering projects. Software projects are shown by default."
  >
    <div
      class="tmux-status mt-6 inline-flex p-1"
      aria-label="Project category filter"
      data-project-filter
    >
      <button
        type="button"
        class="bg-accent text-accent-foreground rounded px-3 py-1 text-sm font-medium"
        aria-pressed="true"
        data-project-filter-button="software"
      >
        Software / Scientific Computing
      </button>
      <button
        type="button"
        class="rounded px-3 py-1 text-sm font-medium opacity-75"
        aria-pressed="false"
        data-project-filter-button="mechanical"
      >
        Mechanical / Engineering
      </button>
    </div>

    <ol class="mt-6 grid gap-4">
      {
        projects.map(project => (
          <li
            class="pane pane-pad"
            hidden={project.category !== "software"}
            data-project-category={project.category}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="text-xl font-semibold">{project.title}</h2>

              {project.period && (
                <p class="text-sm opacity-75">{project.period}</p>
              )}
            </div>

            <div
              class:list={[
                "mt-3 grid gap-4",
                project.media && "md:grid-cols-[minmax(14rem,18rem)_1fr]",
              ]}
            >
              <ProjectMedia media={project.media} />

              <div>
                <p>{project.description}</p>

                {(project.href || project.reportHref) && (
                  <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                    {project.href && (
                      <a
                        href={project.href}
                        target="_blank"
                        class="hover:text-accent underline decoration-dashed underline-offset-4"
                      >
                        View project
                      </a>
                    )}

                    {project.reportHref && (
                      <a
                        href={project.reportHref}
                        target="_blank"
                        class="hover:text-accent underline decoration-dashed underline-offset-4"
                      >
                        View report
                      </a>
                    )}
                  </p>
                )}

                <ul class="mt-3 list-disc space-y-1 ps-5">
                  {project.highlights.map(highlight => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-3 flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <SkillChip label={tag} />
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </Main>

  <Footer />
</Layout>

<script>
  function setupProjectFilter() {
    const filter = document.querySelector<HTMLElement>("[data-project-filter]");
    if (!filter) return;

    const buttons = filter.querySelectorAll<HTMLButtonElement>(
      "[data-project-filter-button]"
    );
    const projectItems = document.querySelectorAll<HTMLElement>(
      "[data-project-category]"
    );

    const activeClasses = ["bg-accent", "text-accent-foreground"];
    const inactiveClasses = ["opacity-75"];

    function setProjectFilter(category: string) {
      buttons.forEach(button => {
        const isActive = button.dataset.projectFilterButton === category;

        button.setAttribute("aria-pressed", String(isActive));
        button.classList.toggle(activeClasses[0], isActive);
        button.classList.toggle(activeClasses[1], isActive);
        button.classList.toggle(inactiveClasses[0], !isActive);
      });

      projectItems.forEach(item => {
        item.hidden = item.dataset.projectCategory !== category;
      });
    }

    buttons.forEach(button => {
      button.addEventListener("click", () => {
        const category = button.dataset.projectFilterButton;
        if (category) setProjectFilter(category);
      });
    });

    setProjectFilter("software");
  }

  setupProjectFilter();

  document.addEventListener("astro:after-swap", setupProjectFilter);
</script>
