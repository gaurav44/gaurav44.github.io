---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { selectedWork } from "@/data/projects";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const recentPosts = getSortedPosts(posts);
const about = await getEntry("pages", "about");
const homePath = getRelativeLocaleUrl(locale, "");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content: AboutContent } = await render(about);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-10 pb-8">
      <h1 class="my-4 inline-block text-4xl font-bold tracking-tight sm:my-8 sm:text-5xl">
        Gaurav Gokhale
      </h1>

      <div class="app-prose mt-2">
        <AboutContent />
      </div>

      <p class="mt-4">
        <a 
          href="/GokhaleCV.pdf"
          target="_blank"
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          >
          View my CV
        </a>
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>
    
    <section id="selected-work" class="border-border border-b pt-12 pb-6">
      <h2 class="section-title">
        Selected Work
      </h2>

      <ul class="mt-6 grid gap-4">
        {
          selectedWork.map(work => (
            <li class="pane pane-pad">
              <h3 class="text-xl font-semibold">
                {work.title}
              </h3>

              <p class="mt-2">
                {work.description}
              </p>

              {
                (work.href || work.reportHref) && (
                  <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                    {work.href && (
                      <a
                        href={work.href}
                        target="_blank"
                        class="hover:text-accent underline decoration-dashed underline-offset-4"
                      >
                        View project
                      </a>
                    )}

                    {work.reportHref && (
                      <a
                        href={work.reportHref}
                        target="_blank"
                        class="hover:text-accent underline decoration-dashed underline-offset-4"
                      >
                        View report
                      </a>
                    )}
                  </p>
                )
              }

              <div class="mt-2 flex flex-wrap gap-2">
                {work.tags.map(tag => (
                  <span class="tag-pill">
                    #{tag}
                  </span>
                ))}
              </div>
            </li>
          ))
        }
      </ul>

    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="section-title">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
